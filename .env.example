# Copy to .env and fill in. Used by docker-compose.yml.
# Routing: our own GraphHopper server (no key, no limit on stops per route).
GRAPHHOPPER_ROUTE_URL=http://10.40.1.114:8989/route
# Public API instead: GRAPHHOPPER_ROUTE_URL=https://graphhopper.com/api/1/route + a key
# (free plan: 5 points per request - longer routes are requested in parts).
GRAPHHOPPER_API_KEY=
# GRAPHHOPPER_MAX_POINTS=5

# Time zone of scenario times (e.g. 07:30). Docker containers run in UTC otherwise.
EMULATOR_TIMEZONE=Europe/Berlin

# Traccar instance for tests / API access (optional)
TRACCAR_URL=http://traccar.local:8082
TRACCAR_USER=user@example.com
TRACCAR_PASSWORD=change-me
